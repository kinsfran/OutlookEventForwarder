<Window x:Class="OutlookEventForwarder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outlook Event Forwarder" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FilterableColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                            <Button Content="&#x25BC;" FontSize="8" Padding="4,2" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Foreground="#888" Click="FilterButton_Click"
                                    Tag="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Filter Calendar Events" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DateFrom" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DateTo" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="Subject contains:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SubjectFilter" Width="180"/>
                    </StackPanel>
                    <Button x:Name="BtnLoadEvents" Content="Load Events" Click="BtnLoadEvents_Click"/>
                    <Button x:Name="BtnClearFilters" Content="Clear Filters" Click="BtnClearFilters_Click"
                            Margin="8,0,0,0" Visibility="Collapsed"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Events List -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <Grid>
                <DataGrid x:Name="EventsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" AlternatingRowBackground="#FAFAFA"
                          BorderThickness="0" ColumnWidth="*"
                          PreviewMouseLeftButtonDown="EventsGrid_PreviewMouseLeftButtonDown"
                          MouseDoubleClick="EventsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40">
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="SelectAllCheckBox" Click="SelectAll_Click"/>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn x:Name="ColSubject" Header="Subject" Binding="{Binding Subject}" Width="*" IsReadOnly="True"
                                            HeaderStyle="{StaticResource FilterableColumnHeader}"/>
                        <DataGridTextColumn x:Name="ColStart" Header="Start" Binding="{Binding StartDisplay}" Width="140" IsReadOnly="True"
                                            HeaderStyle="{StaticResource FilterableColumnHeader}"/>
                        <DataGridTextColumn x:Name="ColEnd" Header="End" Binding="{Binding EndDisplay}" Width="140" IsReadOnly="True"
                                            HeaderStyle="{StaticResource FilterableColumnHeader}"/>
                        <DataGridTextColumn x:Name="ColLocation" Header="Location" Binding="{Binding Location}" Width="150" IsReadOnly="True"
                                            HeaderStyle="{StaticResource FilterableColumnHeader}"/>
                        <DataGridTextColumn x:Name="ColOrganizer" Header="Organizer" Binding="{Binding Organizer}" Width="150" IsReadOnly="True"
                                            HeaderStyle="{StaticResource FilterableColumnHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="PlaceholderText" Text="Set a date range and click 'Load Events' to see your calendar events."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="14" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Filter Popup -->
        <Popup x:Name="FilterPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                    Padding="8" MinWidth="200" MaxHeight="350">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Select All" FontSize="11" Padding="6,2" Click="FilterSelectAll_Click"
                                Background="Transparent" BorderThickness="0" Foreground="#0078D4" Cursor="Hand"/>
                        <TextBlock Text="|" Foreground="#CCC" Margin="4,0" VerticalAlignment="Center" FontSize="11"/>
                        <Button Content="Clear All" FontSize="11" Padding="6,2" Click="FilterClearAll_Click"
                                Background="Transparent" BorderThickness="0" Foreground="#0078D4" Cursor="Hand"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FilterItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,2" FontSize="12" Checked="FilterItem_Changed" Unchecked="FilterItem_Changed"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Recipients -->
        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Recipients" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="RecipientInput"
                                 ToolTip="Enter email address and press Add (or Enter)"
                                 KeyDown="RecipientInput_KeyDown"
                                 TextChanged="RecipientInput_TextChanged"/>
                        <TextBlock x:Name="RecipientPlaceholder"
                                   Text="Type an email address and press Enter (or paste multiple separated by ;)"
                                   Foreground="#AAA" FontSize="12" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                    <Button x:Name="BtnAddRecipient" Grid.Column="1" Content="Add" Margin="8,0,0,0"
                            Click="BtnAddRecipient_Click"/>
                </Grid>
                <ListBox x:Name="RecipientList" Margin="0,8,0,0" MaxHeight="100"
                         BorderThickness="1" BorderBrush="#DDD">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="x" FontSize="10" Padding="4,1" Click="RemoveRecipient_Click"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Foreground="#999" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" Foreground="#666"/>

        <!-- Forward Button -->
        <Button x:Name="BtnForward" Grid.Row="4" Content="Forward Selected Events" Margin="0,12,0,0"
                Height="40" FontSize="15" FontWeight="SemiBold"
                Background="#0078D4" Foreground="White" BorderThickness="0"
                Click="BtnForward_Click"/>
    </Grid>
</Window>
